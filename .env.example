# Copy to .env and fill in. .env is git-ignored; never commit it.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: attribution shown on openrouter.ai activity
OPENROUTER_APP_URL=https://github.com/amritchachadi/ficc-lab
OPENROUTER_APP_TITLE=ficc-lab

# Optional model slot overrides for the router (src/rates_analytics/llm)
FICC_LAB_RESEARCH_MODEL=anthropic/claude-sonnet-5
FICC_LAB_CODE_MODEL=moonshotai/kimi-k2.7-code
FICC_LAB_FAST_MODEL=google/gemini-3.8-flash
